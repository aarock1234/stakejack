{
	"name": "stakejack",
	"version": "0.3.5",
	"private": true,
	"type": "module",
	"description": "Best-move advisor for Pragmatic Play Live Blackjack on Stake.",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox --mv3",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox --mv3",
		"build:all": "pnpm build && pnpm build:firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox --mv3",
		"sign:firefox": "pnpm build:firefox && pnpm dlx web-ext sign --channel=unlisted --source-dir .output/firefox-mv3 --artifacts-dir .output",
		"postinstall": "wxt prepare",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"replay": "tsx scripts/replay-capture.ts"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"clsx": "^2.1.1",
		"cn": "^0.5.0",
		"lucide-react": "^1.61.0",
		"radix-ui": "^1.8.1",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@wxt-dev/module-react": "^1.2.2",
		"eslint": "^9.39.4",
		"eslint-plugin-react-hooks": "^7.1.1",
		"prettier": "^3.8.3",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"wxt": "^0.21.4"
	}
}
